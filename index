<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trợ Lý Giáo Viên & Học Tập</title>
    <script>
        MathJax = { tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] } };
    </script>
    <script type="text/javascript" id="MathJax-script" async src="https://jsdelivr.net"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 20px; color: #333; }
        .container { max-width: 1000px; margin: 0 auto; background: white; border-radius: 15px; box-shadow: 0 20px 40px rgba(0,0,0,0.15); padding: 30px; }
        .header { text-align: center; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 2px solid #f1f5f9; }
        .header h1 { font-size: 2.3em; color: #4a5568; font-weight: 800; }
        .menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
        .menu-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 25px; text-align: center; cursor: pointer; transition: all 0.2s; }
        .menu-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); border-color: #667eea; }
        .menu-card .icon { font-size: 2.5em; margin-bottom: 15px; display: inline-block; }
        .space-section { display: none; }
        .space-section.active { display: block; }
        .back-btn { background: #edf2f7; border: none; padding: 10px 20px; font-weight: 600; border-radius: 8px; cursor: pointer; margin-bottom: 20px; }
        .wheel-box { background: #f8fafc; padding: 20px; border-radius: 10px; text-align: center; margin-bottom: 20px; }
        #winner_display { font-size: 2.5em; font-weight: bold; color: #e53e3e; margin: 20px 0; min-height: 60px; }
        .action-btn { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 12px 30px; font-size: 16px; font-weight: 600; border-radius: 8px; cursor: pointer; width: 100%; }
        textarea { width: 100%; height: 100px; padding: 12px; border-radius: 8px; border: 1px solid #cbd5e1; margin-top: 10px; }
        .calc-box { max-width: 300px; margin: 0 auto 20px auto; background: #1e293b; padding: 15px; border-radius: 12px; }
        #calc_screen { width: 100%; height: 50px; background: #334155; border: none; border-radius: 6px; color: white; text-align: right; padding: 10px; font-size: 1.5em; margin-bottom: 15px; }
        .calc-buttons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
        .calc-btn { padding: 15px; background: #475569; color: white; border: none; border-radius: 6px; cursor: pointer; }
        .calc-btn.op { background: #ea580c; }
        .addon-container { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 25px; margin-top: 20px; }
        .input-group { display: flex; flex-wrap: wrap; gap: 15px; align-items: center; margin: 15px 0; }
        .input-field input { width: 70px; padding: 8px; border: 2px solid #667eea; border-radius: 6px; text-align: center; }
        .result-box { margin-top: 20px; padding: 20px; border: 1px solid #cbd5e1; border-radius: 8px; background: white; }
        canvas { border: 1px solid #ddd; background: #fafafa; border-radius: 8px; max-width: 100%; margin-top: 15px; }
        .bbt-table { width: 100%; border-collapse: collapse; margin: 15px 0; }
        .bbt-table td { border: 1px solid #4a5568; padding: 10px; text-align: center; }
        .bbt-row-y { height: 100px; }
        .bbt-container { position: relative; width: 100%; height: 100%; min-height: 100px; }
        .bbt-node { position: absolute; transform: translate(-50%, -50%); font-weight: 600; font-size: 14px; }
        .bbt-arrow { position: absolute; font-size: 18px; color: #2563eb; transform: translate(-50%, -50%); }
    </style>
</head>
<body>
    <div class="container">
        <div class="header" id="main_header">
            <h1>TRỢ LÝ GIÁO VIÊN & HỌC TẬP</h1>
            <p>"Đổi mới sáng tạo, cùng kiến tạo những giờ học truyền cảm hứng"</p>
        </div>
        <!-- MÀN HÌNH CHÍNH -->
        <div id="main_menu" class="space-section active">
            <div class="menu-grid">
                <div class="menu-card" onclick="switchSection('sec_random')"><span class="icon">🎯</span><h3>Chọn Học Sinh</h3><p>Vòng quay ngẫu nhiên</p></div>
                <div class="menu-card" onclick="switchSection('sec_game')"><span class="icon">🎮</span><h3>Trò Chơi Dạy Học</h3><p>Mini game tương tác</p></div>
                <div class="menu-card" onclick="switchSection('sec_3d')"><span class="icon">📐</span><h3>Mô Phỏng 3D</h3><p>Hình học không gian</p></div>
                <div class="menu-card" onclick="switchSection('sec_docs')"><span class="icon">📝</span><h3>Phiếu Học Tập</h3><p>Mở thư viện tài liệu</p></div>
                <div class="menu-card" onclick="switchSection('sec_assistant')"><span class="icon">🧮</span><h3>Trợ Lý Thao Tác</h3><p>Máy tính & đồ thị</p></div>
            </div>
        </div>

        <!-- MỤC 1 -->
        <div id="sec_random" class="space-section">
            <button class="back-btn" onclick="goBack()">← Quay lại</button>
            <h2 style="margin-bottom:15px;">🎯 GỌI TÊN NGẪU NHIÊN</h2>
            <div class="wheel-box"><div id="winner_display">Sẵn sàng!</div><button class="action-btn" onclick="pickRandomName()">BẮT ĐẦU QUAY</button></div>
            <textarea id="name_list">Nguyễn Văn A&#10;Trần Thị B&#10;Lê Hoàng C&#10;Phạm Minh D</textarea>
        </div>

        <!-- MỤC 2, 3, 4 -->
        <div id="sec_game" class="space-section"><button class="back-btn" onclick="goBack()">← Quay lại</button><h2>🎮 TRÒ CHƠI DẠY HỌC</h2><p>Đang cập nhật...</p></div>
        <div id="sec_3d" class="space-section"><button class="back-btn" onclick="goBack()">← Quay lại</button><h2>📐 MÔ PHỎNG 3D</h2><p>Đang cập nhật...</p></div>
        <div id="sec_docs" class="space-section"><button class="back-btn" onclick="goBack()">← Quay lại</button><h2>📝 PHIẾU HỌC TẬP</h2><button class="action-btn" onclick="window.open('https://google.com', '_blank')">Mở Google Drive</button></div>
        <!-- MỤC 5 -->
        <div id="sec_assistant" class="space-section">
            <button class="back-btn" onclick="goBack()">← Quay lại</button>
            <div class="calc-box">
                <input type="text" id="calc_screen" readonly value="0">
                <div class="calc-buttons">
                    <button class="calc-btn op" onclick="clearCalc()">C</button>
                    <button class="calc-btn op" onclick="pressOp('/')">/</button>
                    <button class="calc-btn op" onclick="pressOp('*')">*</button>
                    <button class="calc-btn op" onclick="pressOp('-')">-</button>
                    <button class="calc-btn" onclick="pressNum('7')">7</button>
                    <button class="calc-btn" onclick="pressNum('8')">8</button>
                    <button class="calc-btn" onclick="pressNum('9')">9</button>
                    <button class="calc-btn op" onclick="pressOp('+')">+</button>
                    <button class="calc-btn" onclick="pressNum('4')">4</button>
                    <button class="calc-btn" onclick="pressNum('5')">5</button>
                    <button class="calc-btn" onclick="pressNum('6')">6</button>
                    <button class="calc-btn op" onclick="calculate()">=</button>
                    <button class="calc-btn" onclick="pressNum('1')">1</button>
                    <button class="calc-btn" onclick="pressNum('2')">2</button>
                    <button class="calc-btn" onclick="pressNum('3')">3</button>
                    <button class="calc-btn" onclick="pressNum('0')">0</button>
                </div>
            </div>

            <div class="addon-container">
                <h3>📊 Khảo sát hàm số & Tạo BBT</h3>
                <select id="func_type" onchange="toggleInputs()" style="padding:8px; margin:10px 0; border-radius:6px; width:100%;">
                    <option value="bac3">Hàm số bậc ba</option>
                    <option value="trungphuong">Hàm số trùng phương</option>
                    <option value="nhatbien">Hàm số nhất biến</option>
                </select>

                <div id="grp_bac3" class="input-grp-sub">
                    <div class="input-group">
                        <div class="input-field">a: <input type="number" id="a3" value="1"></div>
                        <div class="input-field">b: <input type="number" id="b3" value="0"></div>
                        <div class="input-field">c: <input type="number" id="c3" value="-3"></div>
                        <div class="input-field">d: <input type="number" id="d3" value="2"></div>
                    </div>
                </div>
                <div id="grp_trungphuong" class="input-grp-sub" style="display:none;">
                    <div class="input-group">
                        <div class="input-field">a: <input type="number" id="atp" value="1"></div>
                        <div class="input-field">b: <input type="number" id="btp" value="-2"></div>
                        <div class="input-field">c: <input type="number" id="ctp" value="0"></div>
                    </div>
                </div>
                <div id="grp_nhatbien" class="input-grp-sub" style="display:none;">
                    <div class="input-group">
                        <div class="input-field">a: <input type="number" id="anb" value="1"></div>
                        <div class="input-field">b: <input type="number" id="bnb" value="2"></div>
                        <div class="input-field">c: <input type="number" id="cnb" value="1"></div>
                        <div class="input-field">d: <input type="number" id="dnb" value="-1"></div>
                    </div>
                </div>
                <button class="action-btn" onclick="runAnalysis()">KHẢO SÁT & VẼ HÌNH</button>
                <div id="analysis_result" class="result-box" style="display:none;">
                    <div id="text_report"></div>
                    <div id="bbt_space"></div>
                    <div style="text-align:center;"><canvas id="graph_canvas" width="360" height="360"></canvas></div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function switchSection(id) {
            document.querySelectorAll('.space-section').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            if(id !== 'main_menu') document.getElementById('main_header').style.display = 'none';
        }
        function goBack() {
            document.querySelectorAll('.space-section').forEach(s => s.classList.remove('active'));
            document.getElementById('main_menu').classList.add('active');
            document.getElementById('main_header').style.display = 'block';
        }

        // --- ÂM THANH & VÒNG QUAY ---
        let audioCtx = null;
        function playBeep(freq, type, duration) {
            try {
                if(!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                let osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
                osc.type = type; osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.00001, audioCtx.currentTime + duration);
                osc.connect(gain); gain.connect(audioCtx.destination);
                osc.start(); osc.stop(audioCtx.currentTime + duration);
            } catch(e){}
        }

        function pickRandomName() {
            const names = document.getElementById('name_list').value.trim().split('\n').filter(n => n.trim() !== '');
            if(!names.length) return alert('Nhập tên!');
            let display = document.getElementById('winner_display'), count = 0, speed = 60;
            function spin() {
                let rand = Math.floor(Math.random() * names.length);
                display.innerText = names[rand];
                playBeep(600, 'triangle', 0.05);
                count++;
                if(count < 15) { setTimeout(spin, speed); speed += 20; }
                else {
                    display.innerHTML = `🎉 <span style="color:#2f855a">${names[rand]}</span> 🎉`;
                    playBeep(400, 'sine', 0.1); setTimeout(() => playBeep(520, 'sine', 0.15), 100);
                }
            }
            spin();
        }

        // --- MÁY TÍNH ---
        let expr = '';
        function pressNum(n) { expr += n; document.getElementById('calc_screen').value = expr; }
        function pressOp(op) { expr += ' ' + op + ' '; document.getElementById('calc_screen').value = expr; }
        function clearCalc() { expr = ''; document.getElementById('calc_screen').value = '0'; }
        function calculate() { try { let r = eval(expr); document.getElementById('calc_screen').value = r; expr = r.toString(); } catch(e) { document.getElementById('calc_screen').value = 'Lỗi'; expr = ''; } }

        // --- KHẢO SÁT ---
        function toggleInputs() {
            let v = document.getElementById('func_type').value;
            document.querySelectorAll('.input-grp-sub').forEach(el => el.style.display = 'none');
            document.getElementById('grp_' + v).style.display = 'block';
        }
        function fmt(n) { return Number(n.toFixed(2)).toString(); }

        function runAnalysis() {
            let type = document.getElementById('func_type').value, rep = document.getElementById('text_report'), bbt = document.getElementById('bbt_space'), res = document.getElementById('analysis_result');
            res.style.display = 'block'; let f, html = '';
            
            if(type === 'bac3') {
                let a = parseFloat(document.getElementById('a3').value), b = parseFloat(document.getElementById('b3').value), c = parseFloat(document.getElementById('c3').value), d = parseFloat(document.getElementById('d3').value);
                rep.innerHTML = `<b>Hàm bậc 3:</b> $y = ${a}x^3 + ${b}x^2 + ${c}x + ${d}$. Đạo hàm $y' = ${3*a}x^2 + ${2*b}x + ${c}$.`;
                f = x => a*x*x*x + b*x*x + c*x + d;
                let dt = 4*b*b - 12*a*c;
                if(dt > 0) {
                    let x1 = (-2*b - Math.sqrt(dt))/(6*a), x2 = (-2*b + Math.sqrt(dt))/(6*a); if(x1>x2) [x1,x2]=[x2,x1];
                    html = `<table class="bbt-table"><tr><td>$x$</td><td>$-\\infty$</td><td>${fmt(x1)}</td><td>${fmt(x2)}</td><td>$+\\infty$</td></tr><tr><td>$y'$</td><td>${a>0?'+':'-'}</td><td>0</td><td>${a>0?'-':'+'}</td><td>0</td><td>${a>0?'+':'-'}</td></tr><tr class="bbt-row-y"><td>$y$</td><td colspan="4"><div class="bbt-container" id="bbt_c"></div></td></tr></table>`;
                    bbt.innerHTML = html;
                    setTimeout(() => {
                        let div = document.getElementById('bbt_c');
                        if(a > 0) {
                            drawNode(div,5,80,'\(-\infty\)'); drawArrow(div,5,80,33,20,'↗'); drawNode(div,33,20,'CĐ'); drawArrow(div,33,20,66,80,'↘'); drawNode(div,66,80,'CT'); drawArrow(div,66,80,95,20,'↗'); drawNode(div,95,20,'\(+\infty\)');
                        } else {
                            drawNode(div,5,20,'\(+\infty\)'); drawArrow(div,5,20,33,80,'↘'); drawNode(div,33,80,'CT'); drawArrow(div,33,80,66,20,'↗'); drawNode(div,66,20,'CĐ'); drawArrow(div,66,20,95,80,'↘'); drawNode(div,95,80,'\(-\infty\)');
                        }
                        if(window.MathJax) MathJax.typesetPromise([res]);
                    }, 20);
                } else {
                    bbt.innerHTML = `<p>Hàm số đồng biến hoặc nghịch biến trên $\\mathbb{R}$ (Không có cực trị).</p>`;
                }
            } else if(type === 'trungphuong') {
                let a = parseFloat(document.getElementById('atp').value), b = parseFloat(document.getElementById('btp').value), c = parseFloat(document.getElementById('ctp').value);
                rep.innerHTML = `<b>Hàm trùng phương:</b> $y = ${a}x^4 + ${b}x^2 + ${c}$.`;
                f = x => a*x*x*x*x + b*x*x + c;
                bbt.innerHTML = `<p>Trục đối xứng qua Oy. Cực trị tại $x=0$.</p>`;
            } else {
                let a = parseFloat(document.getElementById('anb').value), b = parseFloat(document.getElementById('bnb').value), c = parseFloat(document.getElementById('cnb').value), d = parseFloat(document.getElementById('dnb').value);
                rep.innerHTML = `<b>Hàm nhất biến:</b> $y = \\frac{${a}x+${b}}{${c}x+${d}}$. TC đứng: $x = ${fmt(-d/c)}$, TC ngang: $y = ${fmt(a/c)}$.`;
                f = x => (c*x+d!==0)?(a*x+b)/(c*x+d):null;
                bbt.innerHTML = `<p>Đồ thị Hyperbol phân tách qua đường tiệm cận đứng.</p>`;
            }
            renderCanvas(f);
            if(window.MathJax) MathJax.typesetPromise([res]);
        }

        function renderCanvas(f) {
            let cv = document.getElementById('graph_canvas'), ctx = cv.getContext('2d'), w = cv.width, h = cv.height;
            ctx.clearRect(0,0,w,h); ctx.strokeStyle = '#f1f5f9'; ctx.lineWidth = 1;
            for(let x=0;x<w;x+=20){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}
            for(let y=0;y<h;y+=20){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
            ctx.strokeStyle = '#475569'; ctx.lineWidth = 2;
            ctx.beginPath();ctx.moveTo(0,h/2);ctx.lineTo(w,h/2);ctx.stroke();
            ctx.beginPath();ctx.moveTo(w/2,0);ctx.lineTo(w/2,h);ctx.stroke();
            ctx.strokeStyle = '#e53e3e'; ctx.lineWidth = 2.5; ctx.beginPath(); let s = true;
            for(let px=0;px<w;px+=2) {
                let x = (px-w/2)/20, y = f(x); if(y===null||isNaN(y)||!isFinite(y)){s=true; continue;}
                let py = h/2 - y*20; if(py>=0&&py<=h){if(s){ctx.moveTo(px,py);s=false;}else ctx.lineTo(px,py);}
            }
            ctx.stroke();
        }

        function drawNode(p,x,y,t){let d=document.createElement('div');d.className='bbt-node';d.style.left=x+'%';d.style.top=y+'%';d.innerHTML=t;p.appendChild(d);}
        function drawArrow(p,x1,y1,x2,y2,a){let d=document.createElement('div');d.className='bbt-arrow';d.style.left=((x1+x2)/2)+'%';d.style.top=((y1+y2)/2)+'%';d.innerHTML=a;p.appendChild(d);}
    </script>
</body>
</html>
